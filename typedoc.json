{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/ts/index.ts"],
	"out": "typedoc",
	"name": "tinyimg",
	"readme": "./README.md",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}
